<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/calendrier.css" />
    <link rel="stylesheet" href="StudenTodo.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- PWA -->
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#03173d" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" sizes="512x512" href="icons/icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icons/icon-192.png" />

    <!-- Scripts -->
    <script src="js/pwa-install.js"></script>
    <script src="js/pwa-updater.js"></script>
    <script src="js/pwa-debug.js"></script>
    <script src="js/network-status.js"></script>
    <script src="js/localStorageHelper.js" type="module"></script>
    <script src="js/rappel.js"></script>
    <script>
    let rappelTimeout;

    window.startRappelTimer = function (minutes) {
        clearTimeout(rappelTimeout);
        console.log("Rappel dans " + minutes + " minutes.");
        rappelTimeout = setTimeout(() => {
            alert("⏰ Temps écoulé ! Tu devrais faire une pause ou changer de tâche.");
        }, minutes * 60000);
    };

    window.clearRappelTimer = function () {
        clearTimeout(rappelTimeout);
        console.log("Rappel annulé.");
    };
</script>




    <HeadOutlet />
</head>

<body>
    <div id="offline-notification" style="display: none;" class="offline-indicator">
        Vous êtes actuellement hors ligne. Certaines fonctionnalités peuvent être limitées.
    </div>

    @* Blazor content *@
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>

    <script src="_framework/blazor.web.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(r => console.log('Service Worker enregistré avec succès:', r))
                .catch(e => console.error("Échec de l'enregistrement du Service Worker:", e));
        }
    </script>
    <script src="_content/StudenTodo.Client/js/pwa-diag-visual.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
